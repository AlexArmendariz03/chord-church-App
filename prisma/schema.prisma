generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Las conexiones están en prisma.config.ts (migraciones) y en shared/server/prisma.ts (la app)
datasource db {
  provider = "postgresql"
}

enum UserRole {
  leader
  musico
  // Quien proyecta las letras: solo ve la lista de servicios con sus alabanzas
  proyeccion
  // Administra la app: tiene todos los permisos, incluidos los que no tienen dirigente ni músico
  master
}

enum SongCategory {
  jubilo
  adoracion
}

// Modo claro u oscuro de la interfaz; "system" sigue al del dispositivo
enum ThemePreference {
  light
  dark
  system
}

// Cada iglesia tiene sus usuarios, su cancionero y sus servicios. Solo el master las crea.
model Church {
  id            String    @id @default(cuid())
  name          String    @unique
  createdAt     DateTime  @default(now())
  // Las peticiones de la iglesia: salen en el momento de oración de cada servicio que no traiga las suyas
  prayerGuide   String?
  users         User[]
  songs         Song[]
  services      Service[]
}

// El valor por defecto de churchId es la iglesia que crea la migración add_churches con todo lo que
// ya existía: mientras se publica, el código anterior sigue guardando sin churchId y cae ahí.
// La app siempre lo manda; el valor por defecto se quita en un PR aparte.

model User {
  id       Int             @id @default(autoincrement())
  // Único en toda la app, no solo en su iglesia: el login no pide la iglesia
  username String          @unique
  password String
  role     UserRole        @default(musico)
  // Se guarda en la cuenta para que el tema sea el mismo en todos los dispositivos
  theme    ThemePreference @default(system)
  churchId String          @default("el-palomar")
  church   Church          @relation(fields: [churchId], references: [id], onDelete: Restrict)

  @@index([churchId])
}

model Song {
  id           String        @id @default(cuid())
  name         String
  // Los valores por defecto vienen de la migración que agregó estas columnas a alabanzas que ya
  // existían; la app siempre los manda, pero la base los tiene y el esquema debe decir lo mismo
  key          String        @default("C")
  category     SongCategory  @default(jubilo)
  lyrics       String        @default("")
  payload      Json?
  // Part of the youth group's repertoire: shown with a "Jóvenes" tag
  isYouth      Boolean       @default(false)
  // From the church's service songbook: shown with a "Servicios" tag
  isService    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  serviceSongs ServiceSong[]
  churchId     String        @default("el-palomar")
  church       Church        @relation(fields: [churchId], references: [id], onDelete: Restrict)

  // Para que ServiceSong pueda exigir que la alabanza sea de la misma iglesia que el servicio
  @@unique([id, churchId])
  @@index([churchId])
}

model Service {
  id            String        @id @default(cuid())
  title         String
  eventDate     DateTime
  // Shown to the leader after the last song: one prayer point per line, then the announcements
  prayerGuide   String?
  announcements String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  songs         ServiceSong[]
  churchId      String        @default("el-palomar")
  church        Church        @relation(fields: [churchId], references: [id], onDelete: Restrict)

  // Para que ServiceSong pueda exigir que el servicio sea de la misma iglesia que la alabanza
  @@unique([id, churchId])
  @@index([churchId, eventDate])
}

model ServiceSong {
  id         String       @id @default(cuid())
  serviceId  String
  songId     String
  category   SongCategory
  position   Int
  // The song played during the offering, after the worship set (always a júbilo song)
  isOffering Boolean      @default(false)
  // La iglesia del servicio y de la alabanza: las dos relaciones la incluyen, así la base no deja
  // poner en un servicio una alabanza del cancionero de otra iglesia
  churchId   String       @default("el-palomar")
  service    Service      @relation(fields: [serviceId, churchId], references: [id, churchId], onDelete: Cascade)
  song       Song         @relation(fields: [songId, churchId], references: [id, churchId], onDelete: Cascade)

  @@unique([serviceId, songId])
  @@index([serviceId, category])
}
